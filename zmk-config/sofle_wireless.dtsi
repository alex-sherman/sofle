/*
 * ZMK Common Devicetree Definition for Sofle v2 Wireless (Left & Right PCBs)
 * MCU Module: Raytac MDBT50Q-1MV2 (nRF52840)
 *
 * Matrix Pinout (shared on both Left and Right PCBs):
 *   row0: P0.24 (MDBT50Q Pin 48)
 *   row1: P0.22 (MDBT50Q Pin 46)
 *   row2: P0.20 (MDBT50Q Pin 44)
 *   row3: P0.15 (MDBT50Q Pin 39)
 *   row4: P0.13 (MDBT50Q Pin 37)
 *
 *   col0 (SW6/12/18/24/30): P1.10 (MDBT50Q Pin 3)
 *   col1 (SW5/11/17/23/29): P1.11 (MDBT50Q Pin 4)
 *   col2 (SW4/10/16/22/28): P1.13 (MDBT50Q Pin 6)
 *   col3 (SW3/9/15/21/27):  P1.15 (MDBT50Q Pin 8)
 *   col4 (SW2/8/14/20/26):  P0.29 (MDBT50Q Pin 10)
 *   col5 (SW1/7/13/19):     P0.31 (MDBT50Q Pin 12)
 *
 * Battery Voltage Divider:
 *   VBAT_SENSE: P0.30 / AIN6 (MDBT50Q Pin 14), R5 = 100k (high side), R6 = 220k (low side)
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,battery = &vbatt;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        /*
         * 58-key Sofle v2 layout (Rotary encoders SW25 removed on both halves):
         * Row 0: 6 left + 6 right
         * Row 1: 6 left + 6 right
         * Row 2: 6 left + 6 right
         * Row 3: 6 left + 6 right
         * Row 4: 5 left thumb + 5 right thumb
         */
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                 RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                 RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                    RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4)                 RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    vbatt: vbatt {
        compatible = "zmk,battery-voltage-divider";
        io-channels = <&adc 6>; /* P0.30 = AIN6 */
        output-ohms = <220000>; /* R6 = 220k */
        full-ohms = <(100000 + 220000)>; /* R5 = 100k + R6 = 220k */
    };
};

&adc {
    status = "okay";
};

&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

&usbd {
    status = "okay";
};
